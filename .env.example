# ================================================================
# MULTI-SUBDOMAIN ARCHITECTURE (BlinkStudy only — no mindory.in)
# ================================================================
# - blinkstudy.in              Main website / landing
# - api.blinkstudy.in          Laravel backend API
# - chat.blinkstudy.in         AI chat web app
# - ad.blinkstudy.in            Admin panel (aaPanel site — same public root as main)
# - files.blinkstudy.in        Storage/CDN (optional)
#
# aaPanel Laravel deploy: document root MUST be /www/wwwroot/blinkstudy.in/public
# Run once after deploy: bash scripts/fix-aapanel-laravel-open-basedir.sh
# (fixes open_basedir so vendor/storage are readable — .user.ini alone is not enough)
# ================================================================

# Application Configuration
APP_NAME="BlinkStudy"
APP_ENV=production
APP_KEY=
# Generate with: php artisan key:generate (must decode to >= 32 bytes)
APP_DEBUG=false
APP_URL=https://blinkstudy.in
APP_TIMEZONE=UTC

# ================================================================
# SUBDOMAIN CONFIGURATION (all under blinkstudy.in)
# ================================================================
MAIN_DOMAIN=blinkstudy.in
MAIN_DOMAIN_URL=https://blinkstudy.in

API_SUBDOMAIN=api.blinkstudy.in
API_SUBDOMAIN_URL=https://api.blinkstudy.in

CHAT_SUBDOMAIN=chat.blinkstudy.in
CHAT_SUBDOMAIN_URL=https://chat.blinkstudy.in
CHAT_USE_MAIN_DOMAIN=false
# Local dev only: CHAT_USE_MAIN_DOMAIN=true and leave CHAT_SUBDOMAIN empty

ADMIN_SUBDOMAIN=ad.blinkstudy.in
ADMIN_SUBDOMAIN_URL=https://ad.blinkstudy.in

FILES_SUBDOMAIN=files.blinkstudy.in
FILES_SUBDOMAIN_URL=https://files.blinkstudy.in

# ================================================================
# SECURITY SETTINGS
# ================================================================
# Admin IP Whitelist (comma-separated IPs)
# Leave empty to allow all IPs (NOT recommended for production)
# Example: ADMIN_ALLOWED_IPS=192.168.1.100,10.0.0.50
ADMIN_ALLOWED_IPS=

# CORS Settings (already configured in config/cors.php)

# ================================================================
# STORAGE CONFIGURATION
# ================================================================
# Active storage driver: local, s3, r2, spaces, gcs
ACTIVE_STORAGE=local

# AWS S3 Configuration (if using s3 driver)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Cloudflare R2 Configuration (if using r2 driver)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://api.cloudflare.com/client/v4/accounts

# DigitalOcean Spaces Configuration (if using spaces driver)
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Google Cloud Storage Configuration (if using gcs driver)
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_BUCKET=
GOOGLE_CLOUD_STORAGE_URI=https://storage.googleapis.com

# ================================================================
# RESPONSE SETTINGS
# ================================================================
OPENAI_TEMP=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TOP_P=1
OPENAI_FREQUENCY_PENALTY=0
OPENAI_PRESENCE_PENALTY=0
OPENAI_LANG=hinglish

# ================================================================
# IP Whitelist Configuration
# ================================================================
IP_WHITELIST_ENABLED=false

# ================================================================
# Logging Configuration
# ================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_MAX_FILES=7

# ================================================================
# Performance & Debug Settings
# ================================================================
DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false

# ================================================================
# Database Configuration
# ================================================================
# For production, use MySQL/MariaDB:
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# For local development, you can use SQLite:
# DB_CONNECTION=sqlite

# ================================================================
# Cache, Session, Queue
# ================================================================
# Multi-subdomain (ad/api/chat): SESSION_DOMAIN=.blinkstudy.in is required.
# Prefer database or redis sessions on production (shared across subdomains).
BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=blinkstudy_
FILESYSTEM_DISK=local
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.blinkstudy.in
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
QUEUE_CONNECTION=sync

# ================================================================
# Redis (Optional - for better performance)
# ================================================================
# Uncomment and configure if Redis is available
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

# ================================================================
# Mail Configuration
# ================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@blinkstudy.in"
MAIL_FROM_NAME="${APP_NAME}"

# ================================================================
# Password hashing (bcrypt rounds >= 12, or HASH_DRIVER=argon2id)
# ================================================================
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

# ================================================================
# Sanctum API Authentication
# ================================================================
SANCTUM_STATEFUL_DOMAINS=blinkstudy.in,www.blinkstudy.in,api.blinkstudy.in,chat.blinkstudy.in,ad.blinkstudy.in
# API bearer token lifetime in minutes (clamped to 15–60)
SANCTUM_TOKEN_EXPIRATION=60

# Account lockout after failed OTP / login attempts
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ================================================================
# Renflair SMS Service
# ================================================================
RENFLAIR_API_KEY=
OTP_SMS_ENABLED=true

# MSG91 SMS (optional alternative to Renflair)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ================================================================
# Google Play Store Reviewer Test Account (server-side only — never expose OTP to clients)
TEST_PHONE=
TEST_OTP=
# Optional JSON map for additional dev test numbers, e.g. {"8888888888":"5678"}
TEST_ACCOUNTS=

# Database seeder passwords (required only when running seeders locally)
SEEDER_ADMIN_PASSWORD=
SEEDER_DEMO_USER_PASSWORD=
SEEDER_TOPPER_PASSWORD=

# Support & Admin Emails (auto-derived from MAIN_DOMAIN if not set)
SUPPORT_EMAIL=support@blinkstudy.in
ADMIN_EMAIL=admin@blinkstudy.in

# ================================================================
# Social Login (Google OAuth)
# ================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=${APP_URL}/auth/google/callback
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ================================================================
# Payment Gateways
# ================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ₹1 trial + UPI autopay (Lite ₹79/mo after 2 days)
TRIAL_AUTOPAY_ENABLED=true
TRIAL_PRICE=1
TRIAL_DAYS=2
TRIAL_PLAN_SLUG=lite
TRIAL_RENEWAL_PRICE=79
RAZORPAY_LITE_MONTHLY_PLAN_ID=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=test

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Python AI sidecar (optional)
PYTHON_AI_URL=
PYTHON_AI_KEY=
PYTHON_AI_TIMEOUT=
PYTHON_AI_CACHE_TTL=

# ================================================================
# AI Service API Keys
# ================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Chat speed — GPT first, streaming-friendly (like ChatGPT)
AI_CHAT_PRIMARY_PROVIDER=openai
AI_CHAT_FAST_MODE=true
AI_ADAPTIVE_MODELS=true
AI_PREFER_STREAMING=true
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_COMPLEX_MODEL=gpt-4o
AI_VISION_MODEL=gpt-4o
AI_QUIZ_MODEL=gpt-4o-mini

# ================================================================
# Vite frontend (public only — never put secret keys here)
# ================================================================
VITE_APP_NAME="${APP_NAME}"

# ================================================================
# Hybrid Retrieval Engine (optional — admin can override in panel)
# ================================================================
RETRIEVAL_HYBRID_ENABLED=false
RETRIEVAL_EXA_ENABLED=false
EXA_API_KEY=
RETRIEVAL_HYBRID_MODE=false

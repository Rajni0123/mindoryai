# ================================================================
# MULTI-SUBDOMAIN ARCHITECTURE
# ================================================================
# This configuration supports multi-subdomain architecture:
# - yourdomain.com (Main Website)
# - api.yourdomain.com (Backend API)
# - chat.yourdomain.com (AI Chat Interface)
# - admin.yourdomain.com (Admin Panel)
# - files.yourdomain.com (Storage/CDN - Future)
# ================================================================

# Application Configuration
APP_NAME="BlinkStudy"
APP_ENV=production
APP_KEY=base64:your-app-key-here
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# ================================================================
# SUBDOMAIN CONFIGURATION
# ================================================================
# Main domain
MAIN_DOMAIN=yourdomain.com
MAIN_DOMAIN_URL=https://yourdomain.com

# API subdomain
API_SUBDOMAIN=api.yourdomain.com
API_SUBDOMAIN_URL=https://api.yourdomain.com

# Chat subdomain
CHAT_SUBDOMAIN=chat.yourdomain.com
CHAT_SUBDOMAIN_URL=https://chat.yourdomain.com

# Admin subdomain
ADMIN_SUBDOMAIN=admin.yourdomain.com
ADMIN_SUBDOMAIN_URL=https://admin.yourdomain.com

# Files/Storage subdomain (future)
FILES_SUBDOMAIN=files.yourdomain.com
FILES_SUBDOMAIN_URL=https://files.yourdomain.com

# ================================================================
# SECURITY SETTINGS
# ================================================================
# Admin IP Whitelist (comma-separated IPs)
# Leave empty to allow all IPs (NOT recommended for production)
# Example: ADMIN_ALLOWED_IPS=192.168.1.100,10.0.0.50
ADMIN_ALLOWED_IPS=

# CORS Settings (already configured in config/cors.php)

# ================================================================
# STORAGE CONFIGURATION
# ================================================================
# Active storage driver: local, s3, r2, spaces, gcs
ACTIVE_STORAGE=local

# AWS S3 Configuration (if using s3 driver)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Cloudflare R2 Configuration (if using r2 driver)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://api.cloudflare.com/client/v4/accounts

# DigitalOcean Spaces Configuration (if using spaces driver)
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Google Cloud Storage Configuration (if using gcs driver)
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_BUCKET=
GOOGLE_CLOUD_STORAGE_URI=https://storage.googleapis.com

# ================================================================
# RESPONSE SETTINGS
# ================================================================
OPENAI_TEMP=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TOP_P=1
OPENAI_FREQUENCY_PENALTY=0
OPENAI_PRESENCE_PENALTY=0
OPENAI_LANG=hinglish

# ================================================================
# IP Whitelist Configuration
# ================================================================
IP_WHITELIST_ENABLED=false

# ================================================================
# Logging Configuration
# ================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_MAX_FILES=7

# ================================================================
# Performance & Debug Settings
# ================================================================
DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false

# ================================================================
# Database Configuration
# ================================================================
# For production, use MySQL/MariaDB:
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=blinkstudy_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# For local development, you can use SQLite:
# DB_CONNECTION=sqlite

# ================================================================
# Cache, Session, Queue (PERFORMANCE OPTIMIZED)
# ================================================================
# For production: Use Redis for best performance
# If Redis unavailable: Use 'file' (still fast)
# NEVER use 'database' for cache/session in production (slow!)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=blinkstudy_
FILESYSTEM_DISK=local
# SESSION: Use 'file' for fast sessions (avoid 'database')
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# ================================================================
# Redis (Optional - for better performance)
# ================================================================
# Uncomment and configure if Redis is available
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

# ================================================================
# Mail Configuration
# ================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ================================================================
# Sanctum API Authentication
# ================================================================
SANCTUM_STATEFUL_DOMAINS=${CHAT_SUBDOMAIN},${ADMIN_SUBDOMAIN},${MAIN_DOMAIN}
SANCTUM_TOKEN_EXPIRATION=525600  # 1 year in minutes

# ================================================================
# Renflair SMS Service
# ================================================================
RENFLAIR_API_KEY=
OTP_SMS_ENABLED=true

# ================================================================
# Google Play Store Reviewer Test Account
# ================================================================
# These credentials are for Play Store review purposes only
# The test phone will bypass SMS and use fixed OTP
# Test account automatically gets Ultimate plan
TEST_PHONE=9999999999
TEST_OTP=1234

# Support & Admin Emails (auto-derived from MAIN_DOMAIN if not set)
SUPPORT_EMAIL=support@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ================================================================
# Social Login (Google OAuth)
# ================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=${APP_URL}/auth/google/callback

# ================================================================
# Payment Gateways
# ================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ================================================================
# AI Service API Keys
# ================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=


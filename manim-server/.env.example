# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key

# Gemini AI (for storyboard generation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Edge TTS
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+0%

# Video Output
OUTPUT_DIR=./output
TEMP_DIR=./temp

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Celery (optional - for async processing)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Laravel callback (to notify when video is done)
LARAVEL_API_URL=https://mindory.in/api
LARAVEL_CALLBACK_SECRET=your-callback-secret-here

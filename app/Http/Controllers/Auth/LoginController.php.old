<?php

namespace App\Http\Controllers\Auth;

use App\Http\Controllers\Controller;
use App\Models\SystemSetting;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Session;

class LoginController extends Controller
{
    /**
     * Show the login form for users
     */
    public function showUserLogin()
    {
        if (Auth::check() && Auth::user()->isUser()) {
            return redirect()->route('chat');
        }

        // Get login method settings
        $emailLoginEnabled = SystemSetting::get('auth.email_login_enabled', true);
        $googleLoginEnabled = SystemSetting::get('auth.google_login_enabled', true);

        return view('auth.user-login', compact('emailLoginEnabled', 'googleLoginEnabled'));
    }

    /**
     * Show the login form for admins
     */
    public function showAdminLogin()
    {
        if (Auth::check() && Auth::user()->isAdmin()) {
            return redirect()->route('admin.dashboard');
        }

        return view('auth.admin-login');
    }

    /**
     * Handle user login
     */
    public function userLogin(Request $request)
    {
        // Check if email login is enabled
        if (!SystemSetting::get('auth.email_login_enabled', true)) {
            return back()->with('error', 'Email login is currently disabled. Please contact administrator.');
        }

        $credentials = $request->validate([
            'email' => 'required|email',
            'password' => 'required',
        ]);

        if (Auth::attempt($credentials)) {
            $user = Auth::user();

            // Check if user has 'user' role
            if (!$user->isUser()) {
                Auth::logout();
                return back()->with('error', 'Invalid credentials. Please use admin login.');
            }

            $request->session()->regenerate();
            Session::put('access_granted', true); // For legacy access check

            return redirect()->intended(route('chat'))
                ->with('success', 'Welcome back, ' . $user->name . '!');
        }

        return back()->with('error', 'Invalid email or password.')->onlyInput('email');
    }

    /**
     * Handle admin login
     */
    public function adminLogin(Request $request)
    {
        $credentials = $request->validate([
            'email' => 'required|email',
            'password' => 'required',
        ]);

        if (Auth::attempt($credentials)) {
            $user = Auth::user();

            // Check if user has 'admin' role
            if (!$user->isAdmin()) {
                Auth::logout();
                return back()->with('error', 'Invalid credentials. Please use user login.');
            }

            $request->session()->regenerate();
            Session::put('access_granted', true); // For legacy access check

            return redirect()->intended(route('admin.dashboard'))
                ->with('success', 'Welcome back, Admin!');
        }

        return back()->with('error', 'Invalid email or password.')->onlyInput('email');
    }

    /**
     * Handle logout
     */
    public function logout(Request $request)
    {
        Auth::logout();
        Session::forget('access_granted');
        $request->session()->invalidate();
        $request->session()->regenerateToken();

        return redirect()->route('home')
            ->with('success', 'You have been logged out successfully.');
    }
}
